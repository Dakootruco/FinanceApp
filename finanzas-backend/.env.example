# Configuración del Servidor Express
PORT=3000
NODE_ENV=development

# Configuración de Base de Datos PostgreSQL
DB_USER=mi_usuario
DB_HOST=localhost
DB_DATABASE=app_finanzas
DB_PASSWORD=mi_contraseña
DB_PORT=5432
DB_MAX_CONNECTIONS=20

# Alternativa: URL de conexión directa (usada a menudo en producción/nube)
# DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Configuración de Supabase (Requerido para la autenticación)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=tu_anon_key_de_supabase_local

